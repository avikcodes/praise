{
  "manifest_version": 3,
  "name": "Praise - Capture Testimonials",
  "version": "1.0.0",
  "description": "Capture customer testimonials, reviews, and quotes from any webpage directly into your Praise moderation queue.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_title": "Capture Testimonial with Praise"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ]
}
