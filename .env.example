# ==============================================================================
# Praise Core — Self-Hosted Environment Configuration
# Copy this file to `.env` before running `docker compose up -d`
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Web Application & Public Domain
# ------------------------------------------------------------------------------
# The public canonical URL of your Praise deployment (e.g., https://praise.yourdomain.com).
# Required for embed widget loaders, public forms, Walls of Love, sitemap, and Open Graph cards.
# For local testing without a domain, use: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Host port on which Praise will listen (default: 3000)
HOST_PORT=3000

# ------------------------------------------------------------------------------
# 2. PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
# Name of the database to create
POSTGRES_DB=praise

# PostgreSQL user account
POSTGRES_USER=praise

# Strong database password.
# IMPORTANT: Generate a cryptographically secure random password before deployment!
# Example to generate on Linux / macOS: openssl rand -hex 24
POSTGRES_PASSWORD=replace_with_a_secure_random_password

# Prisma Database Connection String
# When deploying with Docker Compose, the database service host is "db"
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}?schema=public

# ------------------------------------------------------------------------------
# 3. Media & Persistent Storage
# ------------------------------------------------------------------------------
# Directory inside the container where customer video, audio, and image files are stored
PRAISE_UPLOAD_DIR=/app/storage/uploads

# Directory inside the container for persistent application data, tombstones, and analytics
PRAISE_DATA_DIR=/app/data

# ------------------------------------------------------------------------------
# 4. Optional Branding & Legal Entity Details
# ------------------------------------------------------------------------------
# Optional: Real GitHub repository URLs for navbar and footer links.
# If omitted or left empty, external repository links remain hidden.
# NEXT_PUBLIC_REPOSITORY_URL=https://github.com/your-org/praise
# NEXT_PUBLIC_ISSUES_URL=https://github.com/your-org/praise/issues
# NEXT_PUBLIC_RELEASES_URL=https://github.com/your-org/praise/releases
# NEXT_PUBLIC_DISCUSSIONS_URL=https://github.com/your-org/praise/discussions

# Optional: Legal entity name and contact emails for Terms, Privacy, and Cookies pages.
# NEXT_PUBLIC_LEGAL_ENTITY_NAME="Your Organization LLC"
# NEXT_PUBLIC_CONTACT_EMAIL="contact@yourdomain.example"
# NEXT_PUBLIC_PRIVACY_EMAIL="privacy@yourdomain.example"
