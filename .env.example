# Absolute origin used for canonical URLs, Open Graph / Twitter cards,
# sitemap.xml, robots.txt and the JSON-LD identifiers.
#
# Required for production: copy this file to `.env` and set the real
# origin, e.g. NEXT_PUBLIC_SITE_URL=https://your-domain.example
# Read at build time, so set it before running `next build`.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: Real GitHub repository URLs for external navbar and footer links.
# If omitted or left empty, external GitHub links remain hidden.
# NEXT_PUBLIC_REPOSITORY_URL=https://github.com/your-org/praise
# NEXT_PUBLIC_ISSUES_URL=https://github.com/your-org/praise/issues
# NEXT_PUBLIC_RELEASES_URL=https://github.com/your-org/praise/releases
# NEXT_PUBLIC_DISCUSSIONS_URL=https://github.com/your-org/praise/discussions

# Optional: Legal entity name and contact emails for Terms, Privacy, and Cookies pages.
# NEXT_PUBLIC_LEGAL_ENTITY_NAME="Your Organization LLC"
# NEXT_PUBLIC_CONTACT_EMAIL="contact@yourdomain.example"
# NEXT_PUBLIC_PRIVACY_EMAIL="privacy@yourdomain.example"

