  theme                  String      @default("WARM") // WARM, LIGHT, DARK, MIDNIGHT, EMERALD, SUNSET, MINIMAL
  layout                 String      @default("MASONRY") // MASONRY, GRID, CAROUSEL, LIST
  ordering               String      @default("FEATURED_FIRST") // FEATURED_FIRST, NEWEST, HIGHEST_RATED, RANDOM, OLDEST
  isPublished            Boolean     @default(true) // Publish and unpublish
  tagFilter              String?     // JSON array of tags to filter
  selectedTestimonialIds String?     // JSON array of specific testimonial IDs, or empty for all matching
  minRating              Int         @default(0)
  primaryColor           String?     @default("#7049D8")
  customLogoUrl          String?
  ctaEnabled             Boolean     @default(true)
  ctaLabel               String?     @default("Share Your Praise")
  ctaUrl                 String?
  ctaSecondaryEnabled    Boolean     @default(false)
  ctaSecondaryLabel      String?
  ctaSecondaryUrl        String?
  showRatings            Boolean     @default(true)
  showCompany            Boolean     @default(true)
  showAvatar             Boolean     @default(true)
  showDate               Boolean     @default(true)
  showTags               Boolean     @default(true)
  showSource             Boolean     @default(true)
  showFeaturedBadge      Boolean     @default(true)
  allowVideoPlayback     Boolean     @default(true)
  showStats              Boolean     @default(true)
  customCss              String?
  viewsCount             Int         @default(0)
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt

  workspace              Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project                Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  customDomains          CustomDomain[]

  @@unique([workspaceId, slug])
  @@index([workspaceId])
  @@index([projectId])
  @@index([slug])
  @@map("walls_of_love")
}

// -----------------------------------------------------------------------------
// 19. Custom Domains & Hostname Routing
// -----------------------------------------------------------------------------

model CustomDomain {
  id                 String       @id @default(cuid())
  workspaceId        String
  domain             String       @unique // e.g. "reviews.acme.com" - strictly unique across all workspaces!
  targetType         String       // "WALL_OF_LOVE" | "BRAND_PAGE"
  wallOfLoveId       String?
  brandId            String?
  status             String       @default("PENDING_VERIFICATION") // PENDING_VERIFICATION, VERIFIED, ACTIVE, FAILED, MISCONFIGURED
  verificationToken  String       // e.g. "praise-verify-xxxxx"
  verificationMethod String       @default("TXT") // "TXT" or "CNAME"
  cnameTarget        String?      // e.g. "cname.praise.app" or configured CANONICAL_CNAME_TARGET
  verifiedAt         DateTime?
  lastCheckedAt      DateTime?
  errorMessage       String?
  tlsProvisioning    String       @default("REVERSE_PROXY") // "REVERSE_PROXY", "CLOUDFLARE_SSL", "MANUAL_TLS"
  canonicalRedirect  Boolean      @default(true)
  viewsCount         Int          @default(0)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  workspace          Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  wallOfLove         WallOfLove?  @relation(fields: [wallOfLoveId], references: [id], onDelete: SetNull)
  brand              Brand?       @relation(fields: [brandId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([domain])
  @@index([wallOfLoveId])
  @@index([brandId])
  @@map("custom_domains")
}

// -----------------------------------------------------------------------------
// 20. Customer Surveys & Responses
// -----------------------------------------------------------------------------

enum SurveyType {
  NPS
  CSAT
  CES
  FIVE_STAR
  CUSTOM
}

enum SurveyStatus {
  DRAFT
  ACTIVE
  PAUSED
  CLOSED
}

model Survey {
  id                      String          @id @default(cuid())
  workspaceId             String
  projectId               String?
  title                   String
  slug                    String
  description             String?
  type                    SurveyType      @default(NPS)
  status                  SurveyStatus    @default(ACTIVE)

  // Introductory & Branding Content
  welcomeHeading          String?
  welcomeText             String?
  primaryPrompt           String
  feedbackPrompt          String?         @default("What is the primary reason for your score?")
  feedbackRequired        Boolean         @default(false)
  thankYouHeading         String?         @default("Thank you for your feedback!")
  thankYouMessage         String?         @default("Your response helps us improve our product and service.")
  redirectUrl             String?

  // Appearance & Theme
  accentColor             String?         @default("#7049D8")
  theme                   String?         @default("warm")
  customLogoUrl           String?
  showBranding            Boolean         @default(true)

  // Respondent Info Collection
  collectName             Boolean         @default(false)
  nameRequired            Boolean         @default(false)
  collectEmail            Boolean         @default(false)
  emailRequired           Boolean         @default(false)
  collectCompany          Boolean         @default(false)
  companyRequired         Boolean         @default(false)

  // Custom Follow-up Questions (JSON array of SurveyQuestion)
  questionsJson           String?         @default("[]")

  // Scoring configuration & metadata (e.g. scale labels, minimum/maximum labels)
  scoringConfigJson       String?

  viewsCount              Int             @default(0)
  submissionsCount        Int             @default(0)

  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt

  workspace               Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project                 Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  responses               SurveyResponse[]
  routingRules            SurveyRoutingRule[]
  routingLogs             SurveyRoutingLog[]

  @@unique([workspaceId, slug])
  @@index([workspaceId])
  @@index([projectId])
  @@index([slug])
  @@map("surveys")
}

model SurveyResponse {
  id                String        @id @default(cuid())
  surveyId          String
  workspaceId       String
  
  // Score (NPS 0-10, CSAT 1-5, CES 1-7, FIVE_STAR 1-5)
  score             Int?
  scoreType         SurveyType

  // Primary feedback
  feedback          String?

  // Answers to follow-up questions (JSON object: Record<questionId, any>)
  answersJson       String?       @default("{}")

  // Respondent details (if collected)
  respondentName    String?
  respondentEmail   String?
  respondentCompany String?

  // Metadata (IP, user agent, referrer, etc.)
  metadataJson      String?
  submittedAt       DateTime      @default(now())

  survey            Survey        @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  workspace         Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  routingLogs       SurveyRoutingLog[]

  @@index([surveyId])
  @@index([workspaceId])
  @@index([submittedAt])
  @@map("survey_responses")
}

enum RoutingActionType {
  REQUEST_TESTIMONIAL
  INTERNAL_INBOX
  CUSTOMER_SUCCESS_FOLLOWUP
  NOTIFY_TEAM
}

enum RoutingTriggerCondition {
  NPS_PROMOTER
  NPS_PASSIVE
  NPS_DETRACTOR
  CSAT_SATISFIED
  CSAT_NEUTRAL
  CSAT_DISSATISFIED
  CES_LOW_EFFORT
  CES_HIGH_EFFORT
  FIVE_STAR_HIGH
  FIVE_STAR_LOW
  SCORE_BETWEEN
  ALWAYS
}

enum RoutingLogStatus {
  SUCCESS
  SKIPPED
  FAILED
}

model SurveyRoutingRule {
  id               String                  @id @default(cuid())
  workspaceId      String
  surveyId         String?
  name             String
  description      String?
  isEnabled        Boolean                 @default(true)
  priority         Int                     @default(0)

  // Condition Definition
  triggerCondition RoutingTriggerCondition @default(NPS_PROMOTER)
  minScore         Int?
  maxScore         Int?
  requireFeedback  Boolean                 @default(false)
  keywordContains  String?
  requireEmail     Boolean                 @default(false)
  customFilterJson String?

  // Action Definition
  actionType       RoutingActionType       @default(REQUEST_TESTIMONIAL)
  actionConfigJson String?

  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  workspace        Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  survey           Survey?                 @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  logs             SurveyRoutingLog[]

  @@index([workspaceId])
  @@index([surveyId])
  @@index([isEnabled])
  @@map("survey_routing_rules")
}

model SurveyRoutingLog {
  id                String            @id @default(cuid())
  workspaceId       String
  surveyId          String
  responseId        String
  ruleId            String?
  ruleName          String
  actionType        RoutingActionType
  status            RoutingLogStatus  @default(SUCCESS)
  reason            String?
  actionPayloadJson String?
  executedAt        DateTime          @default(now())

  workspace         Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  survey            Survey            @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  response          SurveyResponse    @relation(fields: [responseId], references: [id], onDelete: Cascade)
  rule              SurveyRoutingRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)

  @@unique([responseId, ruleId])
  @@index([workspaceId])
  @@index([surveyId])
  @@index([responseId])
  @@index([executedAt])
  @@map("survey_routing_logs")
}











