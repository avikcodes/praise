datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -----------------------------------------------------------------------------
// Enums
// -----------------------------------------------------------------------------

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}

enum TestimonialStatus {
  PENDING
  APPROVED
  REJECTED
  ARCHIVED
}

enum TestimonialType {
  TEXT
  VIDEO
  AUDIO
}

enum FormFieldType {
  SHORT_TEXT
  LONG_TEXT
  EMAIL
  URL
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  CHECKBOX
  STAR_RATING
  TEXT
  TEXTAREA
  RATING
  SELECT
  BOOLEAN
  // Version 2 Advanced Field Types
  NUMBER
  PHONE
  DATE
  DROPDOWN
  FILE_UPLOAD
  WEBSITE
  LONG_FORM
  CUSTOMER_ROLE
  COMPANY_SIZE
  PRODUCT_PLAN
}

enum MediaType {
  VIDEO
  AUDIO
  IMAGE
}

enum StorageProvider {
  LOCAL
  S3
}

enum WidgetType {
  WALL_OF_LOVE
  GRID
  CAROUSEL
  QUOTE_CARD
}

enum WidgetTheme {
  LIGHT
  DARK
  WARM
  AUTO
}

enum WidgetEventType {
  IMPRESSION
  INTERACTION
  VIDEO_PLAY
}

enum TranscriptionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum VideoExportStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

enum VideoAspectRatio {
  ORIGINAL
  RATIO_16_9
  RATIO_9_16
  RATIO_1_1
  RATIO_4_5
}

enum VideoResolutionProfile {
  RES_720P
  RES_1080P
  RES_4K
}

// -----------------------------------------------------------------------------
// 1. User & Authentication
// -----------------------------------------------------------------------------

model User {
  id           String            @id @default(cuid())
  email        String            @unique
  passwordHash String?
  name         String
  avatarUrl    String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  memberships  WorkspaceMember[]
  sessions     Session[]

  @@map("users")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

// -----------------------------------------------------------------------------
// 2. Multi-Tenant Workspace & Role-Based Access
// -----------------------------------------------------------------------------

model Workspace {
  id             String            @id @default(cuid())
  name           String
  slug           String            @unique
  logoUrl        String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  members        WorkspaceMember[]
  brands         Brand[]
  projects       Project[]
  customers      Customer[]
  forms          CollectionForm[]
  testimonials   Testimonial[]
  mediaAssets    MediaAsset[]
  consentRecords ConsentRecord[]
  tags           Tag[]
  widgets        Widget[]
  widgetEvents   WidgetEvent[]
  apiKeys        ApiKey[]
  formTemplates  FormTemplate[]
  mediaTranscriptions MediaTranscription[]
  videoExportJobs VideoExportJob[]
  testimonialNotes TestimonialNote[]
  moderationActivities ModerationActivity[]
  customerStages CustomerStage[]
  customerAttributeDefinitions CustomerAttributeDefinition[]
  customerSegments CustomerSegment[]
  customerNotes CustomerNote[]
  customerActivities CustomerActivity[]
  customerTags CustomerTag[]
  emailCampaigns EmailCampaign[]
  invitationRecipients InvitationRecipient[]
  invitationTemplates InvitationTemplate[]
  emailSuppressions EmailSuppression[]
  emailCampaignActivities EmailCampaignActivity[]
  smsCampaigns SmsCampaign[]
  smsRecipients SmsRecipient[]
  smsTemplates SmsTemplate[]
  smsSuppressions SmsSuppression[]
  smsProviderConfig SmsProviderConfig?
  rewardPrograms RewardProgram[]
  rewardClaims RewardClaim[]
  thankYous CustomerThankYou[]
  importBatches ImportBatch[]
  platformConnections PlatformConnection[]
  platformSyncLogs PlatformSyncLog[]
  wallsOfLove WallOfLove[]
  customDomains CustomDomain[]
  surveys        Survey[]
  surveyResponses SurveyResponse[]
  surveyRoutingRules SurveyRoutingRule[]
  surveyRoutingLogs SurveyRoutingLog[]

  @@index([slug])
  @@map("workspaces")
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(MEMBER)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([workspaceId])
  @@index([userId])
  @@map("workspace_members")
}

// -----------------------------------------------------------------------------
// 3. Brands & Projects
// -----------------------------------------------------------------------------

model Brand {
  id                     String         @id @default(cuid())
  workspaceId            String
  name                   String
  slug                   String
  logoUrl                String?
  accentColor            String?        @default("#7049D8")
  websiteUrl             String?
  tagline                String?
  description            String?
  theme                  String         @default("WARM") // WARM, LIGHT, DARK, MIDNIGHT, EMERALD, SUNSET, MINIMAL
  isPublished            Boolean        @default(true)
  selectedWallIds        String?        // JSON array of WallOfLove IDs to showcase
  featuredTestimonialIds String?        // JSON array of specific testimonial IDs, or empty for automatic
  ctaEnabled             Boolean        @default(true)
  ctaLabel               String?        @default("Visit Website")
  ctaUrl                 String?
  ctaSecondaryEnabled    Boolean        @default(false)
  ctaSecondaryLabel      String?        @default("Share Praise")
  ctaSecondaryUrl        String?
  socialLinksJson        String?        // JSON: { twitter, linkedin, github, youtube, etc. }
  viewsCount             Int            @default(0)
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  workspace              Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projects               Project[]
  customDomains          CustomDomain[]

  @@unique([workspaceId, slug])
  @@index([workspaceId])
  @@map("brands")
}

model Project {
  id           String           @id @default(cuid())
  workspaceId  String
  brandId      String?
  name         String
  slug         String
  description  String?
  logoUrl      String?
  color        String?          @default("#7049D8")
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  workspace    Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  brand        Brand?           @relation(fields: [brandId], references: [id], onDelete: SetNull)
  forms        CollectionForm[]
  testimonials Testimonial[]
  widgets      Widget[]
  wallsOfLove  WallOfLove[]
  surveys      Survey[]

  @@unique([workspaceId, slug])
  @@index([workspaceId])
  @@index([brandId])
  @@map("projects")
}

// -----------------------------------------------------------------------------
// 4. Customers & Respondents
// -----------------------------------------------------------------------------

model Customer {
  id                   String              @id @default(cuid())
  workspaceId          String
  name                 String
  email                String
  company              String?
  title                String?
  avatarUrl            String?
  socialHandle         String?
  website              String?
  phoneNumber          String?
  stage                String              @default("NEW")
  customAttributesJson String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  workspace            Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  testimonials         Testimonial[]
  customerTags         CustomerTag[]
  notes                CustomerNote[]
  activities           CustomerActivity[]
  invitations          InvitationRecipient[]
  smsInvitations       SmsRecipient[]
  rewardClaims         RewardClaim[]
  thankYous            CustomerThankYou[]

  @@unique([workspaceId, email])
  @@index([workspaceId])
  @@index([workspaceId, stage])
  @@map("customers")
}

// -----------------------------------------------------------------------------
// 5. Collection Forms & Form Fields
// -----------------------------------------------------------------------------

model CollectionForm {
  id                      String        @id @default(cuid())
  workspaceId             String
  projectId               String?
  title                   String
  slug                    String
  description             String?
  headerPrompt            String
  thankYouMessage         String?       @default("Thank you for sharing your feedback!")
  allowVideo              Boolean       @default(true)
  allowAudio              Boolean       @default(true)
  allowText               Boolean       @default(true)
  maxVideoDurationSeconds Int           @default(120)

  // Standard fields configuration
  collectName             Boolean       @default(true)
  nameRequired            Boolean       @default(true)
  collectEmail            Boolean       @default(true)
  emailRequired           Boolean       @default(true)
  collectCompany          Boolean       @default(true)
  companyRequired         Boolean       @default(false)
  collectJobTitle         Boolean       @default(false)
  jobTitleRequired        Boolean       @default(false)
  collectWebsite          Boolean       @default(false)
  websiteRequired         Boolean       @default(false)
  collectRating           Boolean       @default(true)
  ratingRequired          Boolean       @default(false)
  collectText             Boolean       @default(true)
  textRequired            Boolean       @default(true)
  collectAvatar           Boolean       @default(true)

  // Consent configuration
  collectConsent          Boolean       @default(true)
  consentRequired         Boolean       @default(true)
  consentText             String        @default("I grant permission to use my feedback, name, and submitted media for public marketing purposes.")

  // Submission control & Redirect
  submissionsEnabled      Boolean       @default(true)
  redirectUrl             String?

  // Appearance & Branding Customization
  customLogoUrl           String?
  accentColor             String?       @default("#7049D8")
  theme                   String?       @default("warm")

  // Advanced Form Flows (Multi-Step & Conditional Logic)
  isMultiStep             Boolean       @default(false)
  flowConfigJson          String?

  // Form-Level Custom CSS (Scoped & Sanitized)
  customCss               String?

  // Guided Video Recording Controls
  videoInstructions      String?
  recordingQuestionsJson String?

  // Customer Rewards Configuration
  rewardEnabled           Boolean       @default(false)
  rewardProgramId         String?

  isPublished             Boolean       @default(true)
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  workspace               Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project                 Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  rewardProgram           RewardProgram? @relation(fields: [rewardProgramId], references: [id], onDelete: SetNull)
  fields                  FormField[]
  testimonials            Testimonial[]
  campaigns               EmailCampaign[]
  smsCampaigns            SmsCampaign[]
  rewardClaims            RewardClaim[]

  @@unique([workspaceId, slug])
  @@index([workspaceId])
  @@index([projectId])
  @@index([rewardProgramId])
  @@map("collection_forms")
}

model FormField {
  id                  String        @id @default(cuid())
  formId              String
  label               String
  description         String?
  helpText            String?
  placeholder         String?
  type                FormFieldType @default(SHORT_TEXT)
  isRequired          Boolean       @default(false)
  orderIndex          Int           @default(0)
  optionsJson         String?       // For SINGLE_CHOICE / MULTIPLE_CHOICE / DROPDOWN / CUSTOMER_ROLE / COMPANY_SIZE / PRODUCT_PLAN (JSON string array)
  conditionsJson      String?       // Conditional visibility rules (JSON string)
  validationRulesJson String?       // Advanced validation rules (min, max, regex, file extensions, max size, etc.)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  form                CollectionForm @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@index([formId])
  @@map("form_fields")
}

model FormTemplate {
  id          String   @id @default(cuid())
  workspaceId String?
  name        String
  description String?
  category    String   @default("GENERAL") // SAAS, ECOMMERCE, SERVICES, HR, EVENT, GENERAL
  icon        String?  @default("file-text")
  isSystem    Boolean  @default(false)
  configJson  String   // JSON string of full template configuration & form fields

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([category])
  @@map("form_templates")
}

// -----------------------------------------------------------------------------
// 6. Testimonials, Media Assets & Consent Records
// -----------------------------------------------------------------------------

model Testimonial {
  id             String            @id @default(cuid())
  workspaceId    String
  projectId      String?
  formId         String?
  customerId     String?
  content        String
  rating         Int?              @default(5)
  type           TestimonialType   @default(TEXT)
  status         TestimonialStatus @default(PENDING)
  isFeatured     Boolean           @default(false)
  recordingQuestionsJson String?
  // Moderation & Source Details
  sourceType             String            @default("FORM")
  sourceUrl              String?
  importBatchId          String?
  importSourceDetailsJson String?
  mediaHash              String?
  isFlaggedDuplicate     Boolean           @default(false)
  duplicateOfId          String?
  duplicateConfirmedAt   DateTime?
  duplicateConfirmedBy   String?
  duplicateDismissedAt   DateTime?
  duplicateDismissedBy   String?
  submittedAt    DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  workspace      Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project        Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)
  form           CollectionForm?   @relation(fields: [formId], references: [id], onDelete: SetNull)
  customer       Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  mediaAssets    MediaAsset[]
  consentRecords ConsentRecord[]
  tags           TestimonialTag[]
  transcriptions MediaTranscription[]
  videoExportJobs VideoExportJob[]
  notes          TestimonialNote[]
  moderationActivities ModerationActivity[]
  invitationRecipient InvitationRecipient?
  smsRecipient   SmsRecipient?
  rewardClaim    RewardClaim?
  thankYous      CustomerThankYou[]

  @@index([workspaceId])
  @@index([workspaceId, status])
  @@index([workspaceId, type])
  @@index([workspaceId, sourceType])
  @@index([workspaceId, isFlaggedDuplicate])
  @@index([projectId])
  @@index([formId])
  @@index([customerId])
  @@map("testimonials")
}

model MediaAsset {
  id              String          @id @default(cuid())
  workspaceId     String
  testimonialId   String?
  type            MediaType
  storageProvider StorageProvider @default(LOCAL)
  url             String
  localPath       String?
  s3Key           String?
  mimeType        String
  fileSizeBytes   Int?
  durationSeconds Int?
  fileHash        String?
  createdAt       DateTime        @default(now())

  workspace       Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  testimonial     Testimonial?    @relation(fields: [testimonialId], references: [id], onDelete: Cascade)
  transcription   MediaTranscription?
  sourceVideoExports VideoExportJob[] @relation("SourceMediaAsset")
  generatedVideoExport VideoExportJob? @relation("ExportedMediaAsset")

  @@index([workspaceId])
  @@index([testimonialId])
  @@map("media_assets")
}

model MediaTranscription {
  id              String              @id @default(cuid())
  workspaceId     String
  mediaAssetId    String              @unique
  testimonialId   String?
  provider        String              @default("whisper")
  status          TranscriptionStatus @default(PENDING)
  text            String?
  rawText         String?
  language        String?
  confidence      Float?
  durationSeconds Int?
  errorMessage    String?
  attempts        Int                 @default(0)
  maxAttempts     Int                 @default(3)
  isEdited        Boolean             @default(false)
  editedAt        DateTime?
  editedByUserId  String?
  metadataJson    String?
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  workspace       Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  mediaAsset      MediaAsset          @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)
  testimonial     Testimonial?        @relation(fields: [testimonialId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([mediaAssetId])
  @@index([testimonialId])
  @@index([status])
  @@map("media_transcriptions")
}

model VideoExportJob {
  id                   String                 @id @default(cuid())
  workspaceId          String
  testimonialId        String
  sourceMediaAssetId   String
  exportedMediaAssetId String?                @unique
  status               VideoExportStatus      @default(QUEUED)
  progress             Int                    @default(0)
  aspectRatio          VideoAspectRatio       @default(ORIGINAL)
  resolutionProfile    VideoResolutionProfile @default(RES_1080P)
  burnSubtitles        Boolean                @default(true)
  subtitleFont         String                 @default("sans-serif")
  subtitleSize         String                 @default("medium")
  subtitlePosition     String                 @default("bottom")
  subtitleColor        String                 @default("#ffffff")
  subtitleBgColor      String                 @default("rgba(0,0,0,0.6)")
  customSegmentsJson   String?
  outputUrl            String?
  fileSizeBytes        Int?
  durationSeconds      Int?
  sourceResolution     String?
  errorMessage         String?
  attempts             Int                    @default(0)
  maxAttempts          Int                    @default(3)
  startedAt            DateTime?
  completedAt          DateTime?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  workspace            Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  testimonial          Testimonial            @relation(fields: [testimonialId], references: [id], onDelete: Cascade)
  sourceMediaAsset     MediaAsset             @relation("SourceMediaAsset", fields: [sourceMediaAssetId], references: [id], onDelete: Cascade)
  exportedMediaAsset   MediaAsset?            @relation("ExportedMediaAsset", fields: [exportedMediaAssetId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([testimonialId])
  @@index([sourceMediaAssetId])
  @@index([status])
  @@map("video_export_jobs")
}

model ConsentRecord {
  id               String      @id @default(cuid())
  workspaceId      String
  testimonialId    String
  customerName     String
  customerEmail    String
  consentText      String
  ipAddress        String?
  userAgent        String?
  isConsentGranted Boolean     @default(true)
  grantedAt        DateTime    @default(now())
  revokedAt        DateTime?

  workspace        Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  testimonial      Testimonial @relation(fields: [testimonialId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([testimonialId])
  @@map("consent_records")
}

// -----------------------------------------------------------------------------
// 6b. Advanced Moderation: Team Notes & Activity History
// -----------------------------------------------------------------------------

model TestimonialNote {
  id            String      @id @default(cuid())
  workspaceId   String
  testimonialId String
  authorId      String?
  authorName    String?
  authorEmail   String?
  content       String
  isPrivate     Boolean     @default(true) // Always private to authorized workspace members
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  workspace     Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  testimonial   Testimonial @relation(fields: [testimonialId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([testimonialId])
  @@map("testimonial_notes")
}

model ModerationActivity {
  id             String      @id @default(cuid())
  workspaceId    String
  testimonialId  String
  actorId        String?     // User ID or null for system/public submitter
  actorName      String?     // User name or "Public Submitter" / "System"
  actorEmail     String?
  action         String      // SUBMITTED, APPROVED, REJECTED, ARCHIVED, RESTORED, BULK_APPROVED, BULK_REJECTED, BULK_ARCHIVED, BULK_TAGGED, TAGS_UPDATED, NOTE_ADDED, DUPLICATE_FLAGGED, DUPLICATE_DISMISSED, DUPLICATE_MERGED
  previousStatus String?
  newStatus      String?
  details        String?
  metadataJson   String?
  createdAt      DateTime    @default(now())

  workspace      Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  testimonial    Testimonial @relation(fields: [testimonialId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([testimonialId])
  @@index([action])
  @@index([createdAt])
  @@map("moderation_activities")
}

// -----------------------------------------------------------------------------
// 7. Tags & Categorization
// -----------------------------------------------------------------------------

model Tag {
  id           String           @id @default(cuid())
  workspaceId  String
  name         String
  color        String?          @default("#7049D8")
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  workspace    Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  testimonials TestimonialTag[]
  customerTags CustomerTag[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@map("tags")
}

model TestimonialTag {
  testimonialId String
  tagId         String
  workspaceId   String
  createdAt     DateTime    @default(now())

  testimonial   Testimonial @relation(fields: [testimonialId], references: [id], onDelete: Cascade)
  tag           Tag         @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([testimonialId, tagId])
  @@index([workspaceId])
  @@index([tagId])
  @@map("testimonial_tags")
}

// -----------------------------------------------------------------------------
// 8. Widgets & Embed Events
// -----------------------------------------------------------------------------

model Widget {
  id          String        @id @default(cuid())
  workspaceId String
  projectId   String?
  name        String
  type        WidgetType    @default(WALL_OF_LOVE)
  theme       WidgetTheme   @default(WARM)
  configJson  String?       // JSON stringified configuration (accent colors, cards per row, minRating, etc.)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project     Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  events      WidgetEvent[]

  @@index([workspaceId])
  @@index([projectId])
  @@map("widgets")
}

model WidgetEvent {
  id             String          @id @default(cuid())
  workspaceId    String
  widgetId       String
  eventType      WidgetEventType @default(IMPRESSION)
  visitorCountry String?
  recordedAt     DateTime        @default(now())

  workspace      Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  widget         Widget          @relation(fields: [widgetId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([widgetId])
  @@index([recordedAt])
  @@map("widget_events")
}

// -----------------------------------------------------------------------------
// 9. API Keys & Programmatic Access
// -----------------------------------------------------------------------------

enum ApiKeyType {
  SECRET
  PUBLISHABLE
}

model ApiKey {
  id          String        @id @default(cuid())
  workspaceId String
  name        String
  keyPrefix   String        // e.g. "praise_live_sk_..." or "praise_pk_..."
  keyHash     String        @unique // SHA-256 hash of the full token
  type        ApiKeyType    @default(SECRET)
  role        WorkspaceRole @default(MEMBER)
  scopes      String?       // Comma-separated permissions, e.g. "read:testimonials,write:testimonials"
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([keyHash])
  @@map("api_keys")
}

// -----------------------------------------------------------------------------
// 10. Lightweight Customer CRM: Stages, Attributes, Segments, Notes, Activity
// -----------------------------------------------------------------------------

model CustomerStage {
  id          String    @id @default(cuid())
  workspaceId String
  key         String    // NEW, ACTIVE, PROMOTER, CHAMPION, AT_RISK, INACTIVE, or custom
  name        String    // Display Name e.g. "Promoter", "Champion"
  description String?
  color       String?   @default("#10B981")
  order       Int       @default(0)
  isDefault   Boolean   @default(false)
  isSystem    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, key])
  @@index([workspaceId, order])
  @@map("customer_stages")
}

model CustomerAttributeDefinition {
  id          String    @id @default(cuid())
  workspaceId String
  key         String    // Unique identifier e.g. "plan", "nps", "industry"
  name        String    // Display label
  type        String    @default("TEXT") // TEXT, NUMBER, BOOLEAN, DATE, SELECT
  optionsJson String?   // For SELECT: JSON array of string options
  description String?
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, key])
  @@index([workspaceId, order])
  @@map("customer_attribute_definitions")
}

model CustomerSegment {
  id              String    @id @default(cuid())
  workspaceId     String
  name            String
  description     String?
  color           String?   @default("#7049D8")
  icon            String?   @default("Users")
  isDynamic       Boolean   @default(true)
  filterRulesJson String    // JSON definition of dynamic segment matching rules
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@map("customer_segments")
}

model CustomerNote {
