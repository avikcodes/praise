// -----------------------------------------------------------------------------
// 11. Email Testimonial Invitations: Campaigns, Recipient Links, Templates
// -----------------------------------------------------------------------------

model EmailCampaign {
  id                 String                  @id @default(cuid())
  workspaceId        String
  name               String
  status             String                  @default("DRAFT") // DRAFT, SCHEDULED, SENDING, COMPLETED, PAUSED, CANCELLED
  formId             String
  templateId         String?
  subject            String
  bodyText           String
  bodyHtml           String?
  replyToEmail       String?
  fromName           String?
  senderEmail        String?
  timezone           String                  @default("UTC")
  isSequence         Boolean                 @default(false)
  currentStepNumber  Int                     @default(1)
  totalSteps         Int                     @default(1)
  nextRunAt          DateTime?
  recurringInterval  String                  @default("NONE") // NONE, WEEKLY, MONTHLY, QUARTERLY
  recurringNextAt    DateTime?
  totalRecipients    Int                     @default(0)
  sentCount          Int                     @default(0)
  deliveredCount     Int                     @default(0)
  openedCount        Int                     @default(0)
  clickedCount       Int                     @default(0)
  submittedCount     Int                     @default(0)
  bouncedCount       Int                     @default(0)
  failedCount        Int                     @default(0)
  unsubscribedCount  Int                     @default(0)
  confirmedAt        DateTime?
  confirmedBy        String?
  scheduledAt        DateTime?
  startedAt          DateTime?
  completedAt        DateTime?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  workspace          Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  form               CollectionForm          @relation(fields: [formId], references: [id], onDelete: Cascade)
  template           InvitationTemplate?     @relation(fields: [templateId], references: [id], onDelete: SetNull)
  recipients         InvitationRecipient[]
  steps              EmailCampaignStep[]
  activities         EmailCampaignActivity[]
  recipientLogs      CampaignRecipientLog[]

  @@index([workspaceId])
  @@index([workspaceId, status])
  @@index([formId])
  @@index([status, scheduledAt])
  @@index([status, nextRunAt])
  @@map("email_campaigns")
}

model InvitationRecipient {
  id                 String                 @id @default(cuid())
  campaignId         String
  workspaceId        String
  customerId         String?
  email              String
  name               String
  company            String?
  title              String?
  token              String                 @unique // Unique secure token for personal submission & unsubscribe
  customFieldsJson   String?
  status             String                 @default("PENDING") // PENDING, SENT, DELIVERED, OPENED, CLICKED, SUBMITTED, BOUNCED, FAILED, UNSUBSCRIBED
  currentStepNumber  Int                    @default(1)
  lastStepSentAt     DateTime?
  sentAt             DateTime?
  deliveredAt        DateTime?
  openedAt           DateTime?
  clickedAt          DateTime?
  submittedAt        DateTime?
  testimonialId      String?                @unique
  errorMessage       String?
  bounceReason       String?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  campaign           EmailCampaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  workspace          Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  customer           Customer?              @relation(fields: [customerId], references: [id], onDelete: SetNull)
  testimonial        Testimonial?           @relation(fields: [testimonialId], references: [id], onDelete: SetNull)
  recipientLogs      CampaignRecipientLog[]

  @@index([campaignId])
  @@index([workspaceId])
  @@index([customerId])
  @@index([status])
  @@map("invitation_recipients")
}

model EmailCampaignStep {
  id                 String                 @id @default(cuid())
  campaignId         String
  stepNumber         Int                    // 1 = initial invitation, 2 = 1st follow-up, 3 = 2nd follow-up
  delayDays          Int                    @default(0) // Days to wait after previous step (0 for initial step)
  delayHours         Int                    @default(0) // Additional hours
  subject            String
  bodyText           String
  bodyHtml           String?
  templateId         String?
  status             String                 @default("PENDING") // PENDING, SCHEDULED, SENDING, COMPLETED, SKIPPED
  scheduledAt        DateTime?
  sentAt             DateTime?
  sentCount          Int                    @default(0)
  deliveredCount     Int                    @default(0)
  openedCount        Int                    @default(0)
  clickedCount       Int                    @default(0)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  campaign           EmailCampaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  template           InvitationTemplate?    @relation(fields: [templateId], references: [id], onDelete: SetNull)
  recipientLogs      CampaignRecipientLog[]

  @@unique([campaignId, stepNumber])
  @@index([campaignId])
  @@map("email_campaign_steps")
}

model CampaignRecipientLog {
  id                 String              @id @default(cuid())
  campaignId         String
  stepId             String
  stepNumber         Int
  recipientId        String
  idempotencyKey     String              @unique // `${recipientId}_step_${stepNumber}`
  email              String
  status             String              @default("SENT") // SENT, DELIVERED, BOUNCED, FAILED, SKIPPED_SUBMITTED, SKIPPED_UNSUBSCRIBED
  sentAt             DateTime            @default(now())
  deliveredAt        DateTime?
  openedAt           DateTime?
  clickedAt          DateTime?
  errorMessage       String?

  campaign           EmailCampaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  step               EmailCampaignStep   @relation(fields: [stepId], references: [id], onDelete: Cascade)
  recipient          InvitationRecipient @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@unique([recipientId, stepNumber])
  @@index([campaignId])
  @@index([stepId])
  @@index([recipientId])
  @@map("campaign_recipient_logs")
}

model EmailCampaignActivity {
  id                 String          @id @default(cuid())
  campaignId         String
  workspaceId        String
  action             String          // CREATED, SCHEDULED, STEP_DISPATCHED, PAUSED, RESUMED, CANCELLED, STEP_UPDATED, RECURRING_CYCLE
  actorId            String?
  actorName          String?
  stepNumber         Int?
  details            String
  metadataJson       String?
  createdAt          DateTime        @default(now())

  campaign           EmailCampaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  workspace          Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([workspaceId])
  @@map("email_campaign_activities")
}

model InvitationTemplate {
  id          String              @id @default(cuid())
  workspaceId String
  name        String
  category    String              @default("GENERAL") // GENERAL, PRODUCT, EXECUTIVE, POST_PURCHASE, NPS
  subject     String
  bodyText    String
